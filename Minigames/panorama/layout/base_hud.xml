<!-- Deadlock Minigames - base_hud override. Injects the mod's scripts + styles.
     Load order matters: net → rules/* → mg_games (registry + shared widgets) →
     mg_checkers → mg_ttt → mg_chess → mg_durak → mg_connectfour → mg_poker →
     mg_pixelbattle → mg_wordle → ui. -->
<root>
	<styles>
		<include src="s2r://panorama/styles/base.vcss_c" />
		<include src="s2r://panorama/styles/mg.vcss_c" />
	</styles>
	<scripts>
		<include src="s2r://panorama/scripts/mg_net.vjs_c" />
		<include src="s2r://panorama/scripts/mg_sound.vjs_c" />
		<include src="s2r://panorama/scripts/rules/checkers.vjs_c" />
		<include src="s2r://panorama/scripts/rules/ttt.vjs_c" />
		<include src="s2r://panorama/scripts/rules/chess.vjs_c" />
		<include src="s2r://panorama/scripts/rules/connectfour.vjs_c" />
		<include src="s2r://panorama/scripts/rules/durak.vjs_c" />
		<include src="s2r://panorama/scripts/rules/poker.vjs_c" />
		<include src="s2r://panorama/scripts/mg_games.vjs_c" />
		<include src="s2r://panorama/scripts/mg_checkers.vjs_c" />
		<include src="s2r://panorama/scripts/mg_ttt.vjs_c" />
		<include src="s2r://panorama/scripts/mg_chess.vjs_c" />
		<include src="s2r://panorama/scripts/mg_durak.vjs_c" />
		<include src="s2r://panorama/scripts/mg_connectfour.vjs_c" />
		<include src="s2r://panorama/scripts/mg_poker.vjs_c" />
		<include src="s2r://panorama/scripts/mg_pixelbattle_palette.generated.vjs_c" />
		<include src="s2r://panorama/scripts/mg_pixelbattle.vjs_c" />
		<include src="s2r://panorama/scripts/mg_wordle_words.generated.vjs_c" />
		<include src="s2r://panorama/scripts/mg_wordle.vjs_c" />
		<include src="s2r://panorama/scripts/mg_geoguesser_cities.generated.vjs_c" />
		<include src="s2r://panorama/scripts/mg_geo_credits.generated.vjs_c" />
		<include src="s2r://panorama/scripts/mg_geoguesser.vjs_c" />
		<include src="s2r://panorama/scripts/mg_ui.vjs_c" />
	</scripts>
	<Panel class="WindowRoot" hittest="false" disallowedstyleflags="hover,descendantfocus">
		<CitadelHud id="Hud" hittest="false" />
	</Panel>
</root>
