[Unit]
Description=Deadlock Minigames relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minigames
Group=minigames
WorkingDirectory=/opt/deadlock-minigames
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=MG_PUBLIC_ORIGIN=https://178.236.246.13
Environment=MG_DATABASE_PATH=/var/lib/deadlock-minigames/minigames.sqlite
EnvironmentFile=-/etc/deadlock-minigames.env
ExecStart=/usr/local/bin/node /opt/deadlock-minigames/node_server.js
Restart=always
RestartSec=2
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=8192

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/deadlock-minigames
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
